---
interface PostModule {
  frontmatter: { title: string; pubDate: string };
  url: string;
  rawContent: () => string;
}

const PREVIEW_LENGTH = 100;

function makePreview(markdown: string): string {
  const plainText = markdown
    .replace(/^#+\s+/gm, "")
    .replace(/[*_`>]/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/\s+/g, " ")
    .trim();

  if (plainText.length <= PREVIEW_LENGTH) return plainText;
  return plainText.slice(0, PREVIEW_LENGTH).trimEnd() + "…";
}

const postModules = Object.values(
  import.meta.glob<PostModule>("../pages/blog/*.md", { eager: true }),
);

const posts = postModules
  .map((post) => ({
    title: post.frontmatter.title,
    url: post.url,
    pubDate: post.frontmatter.pubDate,
    preview: makePreview(post.rawContent()),
  }))
  .sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a href={post.url}>{post.title}</a>
      <p class="preview">{post.preview}</p>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list li {
    margin: 0.5rem 0;
  }

  .post-list .preview {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted, #666);
  }
</style>
